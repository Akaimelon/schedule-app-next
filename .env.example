# DB接続。ローカルもEC2も同じ形（EC2内のMySQLにlocalhostで繋ぐ）
# 例: mysql://schedule:password@localhost:3306/schedule
DATABASE_URL=

# TLS必須のMySQLに繋ぐ場合のみ、CA証明書の「絶対パス」を設定する。
# 現構成では不要なので空のまま。
DATABASE_SSL_CA=

# Auth.js のセッション暗号化キー。本番は開発用と別のものを新規生成する
# 生成: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth クライアント（Google Cloud Console → APIとサービス → 認証情報）
# リダイレクトURI: https://<ドメイン>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 以下は本番のみ。ローカルでは設定しない。

# Auth.js v5 はVercel以外では転送ヘッダを既定で信用しないため必須
AUTH_TRUST_HOST=true

# これが無いと Auth.js が自分のURLを localhost:3000 と誤認する
# 例: https://schedule-app.org
AUTH_URL=