# DB接続。EC2ではRDSのエンドポイントを指す
# 例（ローカル）: mysql://root:password@localhost:3306/schedule_app
# 例（本番）    : mysql://admin:xxxx@schedule-db.xxxx.ap-northeast-1.rds.amazonaws.com:3306/schedule
DATABASE_URL=

# RDSのCA証明書のパス。★ローカルでは設定しない（設定するとSSL接続を試みて失敗する）
# 本番のみ: certs/rds-ca-ap-northeast-1.pem
DATABASE_SSL_CA=

# Auth.js のセッション暗号化キー。本番は開発用と別のものを新規生成する
# 生成: npx auth secret
AUTH_SECRET=

# GitHub OAuth App の値。★本番用のAppを別途作る（コールバックURLは1つしか登録できないため）
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js v5 はVercel以外では転送ヘッダを既定で信用しない。本番のみ true
AUTH_TRUST_HOST=